# Copy to .env and fill only the keys you need. Never commit .env.
VALKYRIE_DATA_DIR=./valkyrie_data
VALKYRIE_MAX_UPLOAD_MB=25
VALKYRIE_MAX_QUEUE_SIZE=100
VALKYRIE_HOST=127.0.0.1
VALKYRIE_PORT=8011

# Default providers for each stage (can be overridden per job)
VALKYRIE_IMAGE_PROVIDER=openai_gpt_image_1
VALKYRIE_VIDEO_PROVIDER=kling
VALKYRIE_VOICE_PROVIDER=elevenlabs
VALKYRIE_LIPSYNC_PROVIDER=musetalk

# Optional API keys (leave empty to run simulation adapters)
OPENAI_API_KEY=
GEMINI_API_KEY=
FLUX_API_KEY=
KLING_API_KEY=
RUNWAY_API_KEY=
HAILUO_API_KEY=
ELEVENLABS_API_KEY=
